<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_AlerteMedicament" targetNamespace="https://ivia.tg/bpmn" exporter="ivia" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_AlerteMedicament">
    <bpmn:participant id="Pool_AlerteMedicament" name="Alerte médicament — recherche, déblocage et récupération" processRef="Process_AlerteMedicament" />
    <bpmn:textAnnotation id="Note_1"><bpmn:text>Pharmacies validées par l'admin, ouvertes ou de garde, dans un rayon de 5 km (élargi si personne ne répond).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_2"><bpmn:text>La plus proche d'abord. Nom, adresse et téléphone grisés jusqu'au déblocage.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_3"><bpmn:text>Déblocage forfaitaire : 100 F, payé via l'agrégateur.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_4"><bpmn:text>Sur ordonnance (alerte par ordonnance ou médicament signalé par la pharmacie) : pas de livreur ivia, retrait en pharmacie obligatoire.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_5"><bpmn:text>La pharmacie reçoit l'argent ; ivia retient sa commission.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_1" sourceRef="S_Chercher" targetRef="Note_1" />
    <bpmn:association id="Assoc_Note_2" sourceRef="S_Classer" targetRef="Note_2" />
    <bpmn:association id="Assoc_Note_3" sourceRef="C_Payer100" targetRef="Note_3" />
    <bpmn:association id="Assoc_Note_4" sourceRef="G_Ordonnance" targetRef="Note_4" />
    <bpmn:association id="Assoc_Note_5" sourceRef="S_Reverser" targetRef="Note_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AlerteMedicament" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AlerteMedicament">
      <bpmn:lane id="Lane_Client" name="Client (app acheteur)">
        <bpmn:flowNodeRef>Start_Besoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Lancer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Ordonnance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Boite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Nom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Envoyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Voir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Debloquer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Abandon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Payer100</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Choisir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Ordonnance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_SeRendre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_PayerTout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Systeme" name="Système ivia">
        <bpmn:flowNodeRef>S_Chercher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Diffuser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Collecter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dispo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Aucune</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SansResultat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Classer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PaiementOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Reveler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Reserver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Commande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Livreur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Reverser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Livre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pharmacie" name="Pharmacie (app pharmacie)">
        <bpmn:flowNodeRef>P_Recevoir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Repondre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Mettre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Remettre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Retire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Preparer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Paiement" name="Agrégateur de paiement">
        <bpmn:flowNodeRef>A_Deblocage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Commande</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Livreur" name="Livreur ivia">
        <bpmn:flowNodeRef>L_Recuperer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L_Livrer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Besoin" name="Besoin d'un médicament"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="C_Lancer" name="Lancer une alerte"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Type" name="Type d'alerte ?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="C_Ordonnance" name="Photographier l'ordonnance"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="C_Boite" name="Photographier la boîte du médicament"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="C_Nom" name="Saisir le nom du médicament"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Join" name=""><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="C_Envoyer" name="Confirmer sa position et envoyer l'alerte"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="S_Chercher" name="Trouver les pharmacies proches"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="S_Diffuser" name="Diffuser l'alerte aux pharmacies"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="P_Recevoir" name="Recevoir l'alerte (ordonnance, photo ou nom)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:userTask id="P_Repondre" name="Répondre : disponible, prix, sur ordonnance ?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:receiveTask id="S_Collecter" name="Collecter 3 à 4 réponses (10 min max)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G_Dispo" name="Au moins une pharmacie disponible ?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Aucune" name="Prévenir le client : aucune pharmacie trouvée"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="End_SansResultat" name="Alerte sans résultat"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="S_Classer" name="Classer par distance et masquer les identités"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="C_Voir" name="Voir les réponses grisées et le bouton Débloquer"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Debloquer" name="Débloquer ?"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Abandon" name="Alerte abandonnée"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="C_Payer100" name="Payer 100 F (Flooz ou T-Money)"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A_Deblocage" name="Encaisser le déblocage (100 F)"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_PaiementOK" name="Paiement confirmé ?"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Reveler" name="Révéler nom, adresse, téléphone et itinéraire"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="C_Choisir" name="Choisir une pharmacie"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Ordonnance" name="Sur ordonnance ?"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Mode" name="Récupération ?"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Reserver" name="Réserver le médicament et générer un code de retrait"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P_Mettre" name="Mettre le médicament de côté"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="C_SeRendre" name="Aller en pharmacie : ordonnance + code, payer sur place"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_35</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P_Remettre" name="Vérifier ordonnance et code, remettre"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_36</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_Retire" name="Médicament retiré"><bpmn:incoming>Flow_36</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="C_PayerTout" name="Payer médicament + livraison dans l'app"><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="A_Commande" name="Encaisser le paiement de la commande"><bpmn:incoming>Flow_37</bpmn:incoming><bpmn:outgoing>Flow_38</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S_Commande" name="Créer la commande et la notifier à la pharmacie"><bpmn:incoming>Flow_38</bpmn:incoming><bpmn:outgoing>Flow_39</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P_Preparer" name="Préparer la commande"><bpmn:incoming>Flow_39</bpmn:incoming><bpmn:outgoing>Flow_40</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="S_Livreur" name="Attribuer le livreur ivia le plus proche"><bpmn:incoming>Flow_40</bpmn:incoming><bpmn:outgoing>Flow_41</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="L_Recuperer" name="Récupérer la commande à la pharmacie"><bpmn:incoming>Flow_41</bpmn:incoming><bpmn:outgoing>Flow_42</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="L_Livrer" name="Livrer au client (code de remise)"><bpmn:incoming>Flow_42</bpmn:incoming><bpmn:outgoing>Flow_43</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="S_Reverser" name="Reverser à la pharmacie (montant − commission ivia)"><bpmn:incoming>Flow_43</bpmn:incoming><bpmn:outgoing>Flow_44</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_Livre" name="Médicament livré"><bpmn:incoming>Flow_44</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Besoin" targetRef="C_Lancer" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="C_Lancer" targetRef="G_Type" />
    <bpmn:sequenceFlow id="Flow_3" name="Ordonnance" sourceRef="G_Type" targetRef="C_Ordonnance" />
    <bpmn:sequenceFlow id="Flow_4" name="Boîte" sourceRef="G_Type" targetRef="C_Boite" />
    <bpmn:sequenceFlow id="Flow_5" name="Nom" sourceRef="G_Type" targetRef="C_Nom" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="C_Ordonnance" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="C_Boite" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="C_Nom" targetRef="G_Join" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="G_Join" targetRef="C_Envoyer" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="C_Envoyer" targetRef="S_Chercher" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="S_Chercher" targetRef="S_Diffuser" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="S_Diffuser" targetRef="P_Recevoir" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="P_Recevoir" targetRef="P_Repondre" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="P_Repondre" targetRef="S_Collecter" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="S_Collecter" targetRef="G_Dispo" />
    <bpmn:sequenceFlow id="Flow_16" name="Oui" sourceRef="G_Dispo" targetRef="S_Classer" />
    <bpmn:sequenceFlow id="Flow_17" name="Non" sourceRef="G_Dispo" targetRef="S_Aucune" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="S_Aucune" targetRef="End_SansResultat" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="S_Classer" targetRef="C_Voir" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="C_Voir" targetRef="G_Debloquer" />
    <bpmn:sequenceFlow id="Flow_21" name="Non" sourceRef="G_Debloquer" targetRef="End_Abandon" />
    <bpmn:sequenceFlow id="Flow_22" name="Oui" sourceRef="G_Debloquer" targetRef="C_Payer100" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="C_Payer100" targetRef="A_Deblocage" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="A_Deblocage" targetRef="G_PaiementOK" />
    <bpmn:sequenceFlow id="Flow_25" name="Non : réessayer" sourceRef="G_PaiementOK" targetRef="C_Payer100" />
    <bpmn:sequenceFlow id="Flow_26" name="Oui" sourceRef="G_PaiementOK" targetRef="S_Reveler" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="S_Reveler" targetRef="C_Choisir" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="C_Choisir" targetRef="G_Ordonnance" />
    <bpmn:sequenceFlow id="Flow_29" name="Oui : retrait obligatoire" sourceRef="G_Ordonnance" targetRef="S_Reserver" />
    <bpmn:sequenceFlow id="Flow_30" name="Non" sourceRef="G_Ordonnance" targetRef="G_Mode" />
    <bpmn:sequenceFlow id="Flow_31" name="Retrait" sourceRef="G_Mode" targetRef="S_Reserver" />
    <bpmn:sequenceFlow id="Flow_32" name="Livraison" sourceRef="G_Mode" targetRef="C_PayerTout" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="S_Reserver" targetRef="P_Mettre" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="P_Mettre" targetRef="C_SeRendre" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="C_SeRendre" targetRef="P_Remettre" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="P_Remettre" targetRef="End_Retire" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="C_PayerTout" targetRef="A_Commande" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="A_Commande" targetRef="S_Commande" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="S_Commande" targetRef="P_Preparer" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="P_Preparer" targetRef="S_Livreur" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="S_Livreur" targetRef="L_Recuperer" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="L_Recuperer" targetRef="L_Livrer" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="L_Livrer" targetRef="S_Reverser" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="S_Reverser" targetRef="End_Livre" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AlerteMedicament">
    <bpmndi:BPMNPlane id="Plane_AlerteMedicament" bpmnElement="Collab_AlerteMedicament">
      <bpmndi:BPMNShape id="Pool_AlerteMedicament_di" bpmnElement="Pool_AlerteMedicament" isHorizontal="true"><dc:Bounds x="160" y="80" width="4120" height="1240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true"><dc:Bounds x="190" y="80" width="4090" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Systeme_di" bpmnElement="Lane_Systeme" isHorizontal="true"><dc:Bounds x="190" y="420" width="4090" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pharmacie_di" bpmnElement="Lane_Pharmacie" isHorizontal="true"><dc:Bounds x="190" y="740" width="4090" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Paiement_di" bpmnElement="Lane_Paiement" isHorizontal="true"><dc:Bounds x="190" y="980" width="4090" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Livreur_di" bpmnElement="Lane_Livreur" isHorizontal="true"><dc:Bounds x="190" y="1140" width="4090" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Besoin_di" bpmnElement="Start_Besoin"><dc:Bounds x="252" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="215.0" y="274" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Lancer_di" bpmnElement="C_Lancer"><dc:Bounds x="330" y="210" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Type_di" bpmnElement="G_Type" isMarkerVisible="true"><dc:Bounds x="490" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="460.0" y="281" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Ordonnance_di" bpmnElement="C_Ordonnance"><dc:Bounds x="590" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Boite_di" bpmnElement="C_Boite"><dc:Bounds x="590" y="210" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Nom_di" bpmnElement="C_Nom"><dc:Bounds x="590" y="315" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Join_di" bpmnElement="G_Join" isMarkerVisible="true"><dc:Bounds x="760" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="730.0" y="281" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Envoyer_di" bpmnElement="C_Envoyer"><dc:Bounds x="850" y="210" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Chercher_di" bpmnElement="S_Chercher"><dc:Bounds x="850" y="450" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Diffuser_di" bpmnElement="S_Diffuser"><dc:Bounds x="1010" y="450" width="110" height="80" /></bpmndi:BPMNShape>
