    <bpmn:startEvent id="Start" name="Ouvre l&#39;application">
      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A1" name="Saisir son numéro de téléphone">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="Normaliser et valider le numéro (+228…)">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Numéro valide ?">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S2" name="Contrôler limites d&#39;envoi et appareil (anti-fraude)">
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Demande autorisée ?">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SBlock" name="Refuser (message générique) et journaliser">
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EBlock" name="Demande refusée">
      <bpmn:incoming>f09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S4" name="Générer le code OTP (6 chiffres, 5 min, usage unique, haché)">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Numéro sur WhatsApp ?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S5" name="Envoyer l&#39;OTP par WhatsApp">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="S6" name="Envoyer l&#39;OTP par SMS">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="A2" name="Réception du code OTP (WhatsApp / SMS)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="A3" name="Saisir le code OTP">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="Action de l&#39;utilisateur ?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S7" name="Vérifier le code (valide, non expiré, non utilisé)">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G6" name="Code valide ?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S8" name="Incrémenter le compteur d&#39;essais">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G7" name="Essais &#60; 5 ?">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S10" name="Invalider le code, verrouiller le numéro 15 min, journaliser">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ELock" name="Numéro verrouillé temporairement">
      <bpmn:incoming>f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S9" name="Invalider le code (usage unique)">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G8" name="Compte existant ?">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A5" name="Saisir son nom &#38; prénom">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S11" name="Créer le compte acheteur">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="M">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:incoming>f35</bpmn:incoming>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S13" name="Émettre la session et journaliser la connexion">
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="A6" name="Stocker la session (Keychain / Keystore)">
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EOk" name="Connecté / inscrit">
      <bpmn:incoming>f40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G9" name="Appareil connu ?">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S12" name="Alerter : connexion depuis un nouvel appareil">
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="S14" name="Notifier le back-office (nouvel acheteur)">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="B1" name="Recevoir la notification d&#39;inscription">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EB" name="Notification traitée">
      <bpmn:incoming>f34</bpmn:incoming>
    </bpmn:endEvent>
