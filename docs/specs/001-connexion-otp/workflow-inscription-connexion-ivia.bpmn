<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Ivia_Auth" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_Ivia_Auth">
    <bpmn:participant id="Participant_Ivia_Auth" name="Workflow Inscription / Connexion Ivia" processRef="Process_Ivia_Auth" />
    <bpmn:textAnnotation id="TA1">
      <bpmn:text>Même parcours à l'écran que le numéro soit connu ou non (pas d'énumération de comptes)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_TA1" associationDirection="None" sourceRef="A1" targetRef="TA1" />
    <bpmn:textAnnotation id="TA2">
      <bpmn:text>WhatsApp par défaut. SMS si le numéro n'est pas sur WhatsApp ou si l'envoi échoue</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_TA2" associationDirection="None" sourceRef="A2" targetRef="TA2" />
    <bpmn:textAnnotation id="TA3">
      <bpmn:text>Aucun compte n'est créé avant la validation du code ; inscription incomplète expirée après 15 min</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_TA3" associationDirection="None" sourceRef="A5" targetRef="TA3" />
    <bpmn:textAnnotation id="TA4">
      <bpmn:text>Limites par numéro, appareil et IP + plafond global ; alerte au back-office si seuil dépassé</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_TA4" associationDirection="None" sourceRef="SBlock" targetRef="TA4" />
    <bpmn:textAnnotation id="TA5">
      <bpmn:text>Jeton d'accès court + jeton de rafraîchissement renouvelé à chaque usage ; session révocable</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_TA5" associationDirection="None" sourceRef="S13" targetRef="TA5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Ivia_Auth" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Backoffice" name="Back-Office Admin">
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Systeme" name="Système automatisé">
