# Variables d'environnement attendues par le projet.
# Copier vers .env et compléter avec les vraies valeurs. Ne jamais committer .env.
# Chaque variable ajoutée au code doit apparaître ici, sans valeur, avec un commentaire.
# Rappel : les variables préfixées NEXT_PUBLIC_, VITE_, EXPO_PUBLIC_… sont visibles dans le navigateur.

# ---------------------------------------------------------------- Backend : général
APP_ENV=               # obligatoire : local | test | staging | production. Hors local : implémentations factices et routes /v1/dev refusées
PORT=                  # port d'écoute de l'API (8080 par défaut)
DATABASE_URL=          # obligatoire. Local (docker compose) : postgres://ivia@localhost:5432/ivia?sslmode=disable (adapter le port à POSTGRES_PORT)
PUBLIC_BASE_URL=       # adresse publique de l'API (ex. https://api.ivia.tg) ; http://localhost:PORT par défaut
LOG_LEVEL=             # debug | info (défaut) | warn | error
TRUST_PROXY_HEADERS=   # true derrière Caddy (lit l'adresse du client dans X-Forwarded-For) ; false par défaut
RUN_WORKERS=           # true (défaut) : exécute les tâches de fond River dans le processus de l'API

# ---------------------------------------------------------------- Backend : connexion
AUTH_SECRET=           # au moins 32 caractères aléatoires (clé HMAC des codes OTP). Obligatoire hors local
SESSION_TTL=           # durée de vie glissante des sessions, durée Go (1440h = 60 jours par défaut)
OTP_SENDER=            # log (local : code affiché dans les journaux) | brevo
BREVO_API_KEY=         # clé API Brevo (OTP_SENDER=brevo)
BREVO_SENDER_EMAIL=    # adresse d'envoi validée chez Brevo (SPF, DKIM)
BREVO_SENDER_NAME=     # nom d'expéditeur (ivia par défaut)

# ---------------------------------------------------------------- Backend : paiement (ADR 0007)
PAYMENT_PROVIDER=      # fake (local, staging) ; l'agrégateur réel sera ajouté une fois choisi
PAYMENT_WEBHOOK_SECRET= # secret de signature des webhooks (16 caractères au moins hors local)

# ---------------------------------------------------------------- Backend : notifications push
PUSH_SENDER=           # log (local) | fcm
FCM_CREDENTIALS_FILE=  # chemin du fichier JSON du compte de service Firebase (PUSH_SENDER=fcm), hors du dépôt

# ---------------------------------------------------------------- Backend : fichiers (ADR 0008)
STORAGE=               # local (disque, servi par l'API sous /dev/storage) | r2
LOCAL_STORAGE_DIR=     # dossier des fichiers en local (./var/uploads par défaut)
R2_ACCOUNT_ID=         # identifiant du compte Cloudflare
R2_ACCESS_KEY_ID=      # clé d'accès R2 (droits limités aux deux compartiments)
R2_SECRET_ACCESS_KEY=  # secret de la clé R2
R2_PUBLIC_BUCKET=      # compartiment des photos (lecture publique)
R2_PRIVATE_BUCKET=     # compartiment des documents des livreurs (jamais public)
R2_PUBLIC_BASE_URL=    # domaine public du compartiment des photos (ex. https://media.ivia.tg)

# ---------------------------------------------------------------- docker-compose.yml
POSTGRES_PORT=         # port local de PostgreSQL (5432 par défaut ; changer s'il est déjà pris)
