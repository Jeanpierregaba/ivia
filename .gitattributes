# Fins de ligne LF pour tout le dépôt, quel que soit le réglage Git de la machine (cf. .editorconfig).
* text=auto eol=lf

# Scripts Windows : CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.jar binary
