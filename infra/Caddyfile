# HTTPS automatique (Let's Encrypt) devant l'API et le back-office.
{
	# Journaux d'accès sans chaîne de requête : elle peut contenir une position ou une recherche.
	log {
		output stdout
		format json
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Corps limité à 2 Mo (l'API en accepte 1 ; les fichiers vont directement vers R2).
	request_body {
		max_size 2MB
	}

	reverse_proxy api:8080 {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete *
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy admin:3000

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete *
				}
				request>headers>Cookie delete
			}
		}
	}
}
