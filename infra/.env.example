# Copier vers infra/.env sur le serveur (chmod 600). Jamais commité.
# Ce fichier ne contient AUCUN secret : les mots de passe et clés sont dans infra/secrets/, un
# fichier par secret, créés par `sudo ./init-secrets.sh` (voir infra/README.md).
# Les variables de l'API sont décrites dans ../.env.example ; ici, la valeur attendue en production.

# ---------------------------------------------------------------- Déploiement
GHCR_OWNER=            # propriétaire GitHub des images (ex. jeanpierregaba), en minuscules
API_TAG=               # SHA du commit à déployer (image publiée par la CI)
API_DOMAIN=            # ex. api.ivia.tg (DNS pointant vers le VPS)
ADMIN_TAG=             # SHA du commit du back-office à déployer (image publiée par la CI)
ADMIN_DOMAIN=          # ex. admin.ivia.tg (DNS pointant vers le VPS)
BACKUP_REMOTE=         # destination rclone chiffrée des sauvegardes (défaut : ivia-backup)

# ---------------------------------------------------------------- API (réglages sans secret)
APP_ENV=               # production (ou staging)
PUBLIC_BASE_URL=       # https://api.ivia.tg
SESSION_TTL=
OTP_SENDER=            # brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
PAYMENT_PROVIDER=      # fake en staging uniquement ; l'agrégateur réel en production (tâche 016)
PUSH_SENDER=           # fcm
STORAGE=               # r2
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
LOG_LEVEL=

# ---------------------------------------------------------------- Secrets : NE PAS les mettre ici
# Fichiers dans infra/secrets/, passés à l'API par docker-compose.yml (variables <NOM>_FILE) :
#   postgres_password, database_url, auth_secret, payment_webhook_secret   (générés)
#   brevo_api_key, r2_access_key_id, r2_secret_access_key, sentry_dsn       (demandés sans écho)
#   fcm.json                                                                (compte de service Firebase)
# L'API refuse de démarrer si une variable et son fichier sont définis ensemble, si un fichier est
# lisible par d'autres (droits autres que 400/600) ou si un secret est court, d'exemple ou peu aléatoire.
