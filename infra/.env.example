# Copier vers infra/.env sur le serveur (chmod 600). Jamais commité.
# Les variables de l'API sont décrites dans ../.env.example ; ici, la valeur attendue en production.

# ---------------------------------------------------------------- Déploiement
GHCR_OWNER=            # propriétaire GitHub des images (ex. jeanpierregaba), en minuscules
API_TAG=               # SHA du commit à déployer (image publiée par la CI)
API_DOMAIN=            # ex. api.ivia.tg (DNS pointant vers le VPS)
POSTGRES_PASSWORD=     # mot de passe long et aléatoire
BACKUP_BUCKET=         # compartiment R2 privé des sauvegardes

# ---------------------------------------------------------------- API
APP_ENV=               # production (ou staging)
PUBLIC_BASE_URL=       # https://api.ivia.tg
AUTH_SECRET=           # 32 caractères aléatoires au moins (openssl rand -base64 48)
SESSION_TTL=
OTP_SENDER=            # brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
PAYMENT_PROVIDER=      # fake en staging uniquement ; l'agrégateur réel en production (tâche 016)
PAYMENT_WEBHOOK_SECRET=
PUSH_SENDER=           # fcm
FCM_CREDENTIALS_FILE=  # /run/secrets/fcm.json (fichier dans infra/secrets/)
STORAGE=               # r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
SENTRY_DSN=
LOG_LEVEL=
